<li><span style="font-family: georgia, palatino, serif; font-size: 14pt; color: #000000;">Scarica le<span style="color: #ff9900;"> <a style="color: #ff9900;" href="https://www.parcoappiaantica.it/visitare-il-parco/audioguide/" target="_blank" rel="noopener"><strong>audioguide</strong></a></span></span></li>
<li><span style="font-family: georgia, palatino, serif; font-size: 14pt; color: #000000;">Scarica l’itinerario “La Valle della Caffarella – il Sentiero dell’Acqua” <strong><span style="color: #ff9900;"><a style="color: #ff9900;" href="https://www.parcoappiaantica.it/wp-content/uploads/2016/05/ItinerariCaffarella_SentieroAcqua.pdf" class="mtli_attachment mtli_pdf" data-mtli="mtli_filesize602,15kB" target="_blank" rel="noopener">ITA</a></span></strong> | <span style="color: #ff9900;"><strong><a style="color: #ff9900;" href="https://www.parcoappiaantica.it/wp-content/uploads/2016/05/CaffarellaValley_WaterPathENG.pdf" class="mtli_attachment mtli_pdf" data-mtli="mtli_filesize654,96kB" target="_blank" rel="noopener">ENG</a></strong></span></span></li>
